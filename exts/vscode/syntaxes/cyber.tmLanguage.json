{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Cyber",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comment"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.cyber",
				"match": "\\b(use|fn|if|else|and|or|not|try|catch|for|while|break|continue|return|as|type|struct|enum|trait|const|global|switch|case|pass|move|await|yield|generator|fiber|suspend|scope|import|var|func)\\b"
			}]
		},
		"strings": {
			"name": "string.quoted.double.cyber",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.cyber",
					"match": "\\\\."
				}
			]
		},
		"comment": {
			"patterns": [
				{
					"begin": "--",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.cyber"
						}
					},
					"end": "\\n",
					"name": "comment.line.double-dash.cyber"
				}
			]
		}
	},
	"scopeName": "source.cyber"
}
