use time
use t 'test'

-- Dates.
d := time.date(2024, 1, 31)!
t.eq(2024, d.year())
t.eq(1, d.month())
t.eq(31, d.day())
t.eq('2024-01-31', d.format())
t.eq(time.Weekday.wednesday, d.weekday())
t.eq(3, d.iso_weekday())
t.eq(31, d.day_of_year())
t.eq(366, time.date(2024, 12, 31)!.day_of_year())
t.eq(time.Weekday.thursday, time.date(1970, 1, 1)!.weekday())
t.eq(time.Weekday.monday, time.date(1, 1, 1)!.weekday())
t.eq(time.Weekday.friday, time.date(9999, 12, 31)!.weekday())
t.eq('0001-01-01', time.date(1, 1, 1)!.format())
t.eq(error.Range, time.date(2023, 2, 29).unwrap_error())
t.eq(error.Range, time.date(2024, 13, 1).unwrap_error())
t.eq(error.Range, time.date(0, 1, 1).unwrap_error())
t.eq(error.Range, time.date(10000, 1, 1).unwrap_error())
t.eq(true, time.is_leap_year(2024))
t.eq(true, time.is_leap_year(2000))
t.eq(false, time.is_leap_year(1900))
t.eq(29, time.days_in_month(2024, 2))
t.eq(28, time.days_in_month(2023, 2))
t.eq(30, time.days_in_month(2023, 11))

-- Date arithmetic. A month shift keeps the day or takes the last day of the month.
t.eq('2024-02-29', d.add_months(1)!.format())
t.eq('2023-02-28', d.add_months(-11)!.format())
t.eq('2024-03-31', d.add_months(2)!.format())
t.eq('2025-01-31', d.add_years(1)!.format())
t.eq('2025-02-28', time.date(2024, 2, 29)!.add_years(1)!.format())
t.eq('2024-03-01', d.add_days(30)!.format())
t.eq('2023-12-31', d.add_days(-31)!.format())
t.eq(error.Range, time.date(9999, 12, 31)!.add_days(1).unwrap_error())
t.eq(error.Range, time.date(1, 1, 1)!.add_months(-1).unwrap_error())
t.eq(error.Range, d.add_years(8000).unwrap_error())
t.eq(47, time.date(2027, 1, 1)! - time.date(2026, 11, 15)!)
t.eq(-366, time.date(2024, 1, 1)! - time.date(2025, 1, 1)!)
t.eq(3652058, time.date(9999, 12, 31)! - time.date(1, 1, 1)!)
t.eq(true, d < time.date(2024, 2, 1)!)
t.eq(true, d <= d)
t.eq(false, d > d)
t.eq(true, d >= d)
t.eq(true, d == time.date(2024, 1, 31)!)

-- ISO weeks.
t.eq(53, time.date(2021, 1, 3)!.iso_week().week)
t.eq(2020, time.date(2021, 1, 3)!.iso_week().year)
t.eq(1, time.date(2024, 12, 30)!.iso_week().week)
t.eq(2025, time.date(2024, 12, 30)!.iso_week().year)
t.eq(1, time.date(2026, 1, 1)!.iso_week().week)

-- Date and time of day.
dt := time.datetime(2026, 11, 15, 23, 59, 58, 123456789, 330)!
t.eq('2026-11-15T23:59:58.123456789+05:30', dt.format())
t.eq('2026-11-15T18:29:58.123456789Z', dt.utc().format())
t.eq(2026, dt.year())
t.eq(11, dt.month())
t.eq(15, dt.day())
t.eq(23, dt.hour())
t.eq(59, dt.minute())
t.eq(58, dt.second())
t.eq(123456789, dt.nanosecond())
t.eq(330, dt.offset())
t.eq(time.Weekday.sunday, dt.weekday())
t.eq(319, dt.day_of_year())
t.eq('2026-11-15', dt.date().format())
t.eq(1794767398, dt.time().unix())
t.eq(1794767398123, dt.time().unix_millis())
t.eq(123456789, dt.time().subsec_nanos())
t.eq('2026-11-15T10:22:03Z', time.datetime(2026, 11, 15, 10, 22, 3)!.format())
t.eq('2026-11-15T10:22:03.5Z', time.datetime(2026, 11, 15, 10, 22, 3, 500000000, 0)!.format())
t.eq('2026-11-15T00:00:00-03:30', time.date(2026, 11, 15)!.at(0, 0, 0, 0, -210)!.format())
t.eq('2026-11-15T12:30:00Z', time.date(2026, 11, 15)!.at(12, 30, 0)!.format())
t.eq(error.Range, time.datetime(2026, 11, 15, 24, 0, 0).unwrap_error())
t.eq(error.Range, time.datetime(2026, 11, 15, 0, 60, 0).unwrap_error())
t.eq(error.Range, time.datetime(2026, 2, 30, 0, 0, 0).unwrap_error())
t.eq(error.Range, time.datetime(2026, 11, 15, 0, 0, 0, 0, 1440).unwrap_error())
t.eq(error.Range, time.datetime(2026, 11, 15, 0, 0, 0, 1000000000, 0).unwrap_error())
-- The first and the last day are out of the range of an instant: any offset keeps the year in range.
t.eq(error.Range, time.datetime(1, 1, 1, 23, 59, 59).unwrap_error())
t.eq('0001-01-02T00:00:00Z', time.datetime(1, 1, 2, 0, 0, 0)!.format())
t.eq('0001-01-01T00:01:00-23:59', time.datetime(1, 1, 2, 0, 0, 0)!.to_offset(-1439)!.format())
t.eq('9999-12-31T23:58:59+23:59', time.datetime(9999, 12, 30, 23, 59, 59)!.to_offset(1439)!.format())

-- Offsets: the same instant, or the same time of day.
t.eq('2026-11-15T14:59:58.123456789-03:30', dt.to_offset(-210)!.format())
t.eq('2026-11-15T23:59:58.123456789Z', dt.replace_offset(0)!.format())
t.eq(error.Range, dt.to_offset(1440).unwrap_error())
t.eq(error.Range, dt.replace_offset(-1440).unwrap_error())
-- `==` compares the offset too. The instants compare with `time()`.
t.eq(false, dt == dt.utc())
t.eq(true, dt.time() == dt.utc().time())
t.eq(true, dt.time() < (dt + time.nanos(1)).time())

-- Moving a date and time of day.
t.eq('2026-11-16T00:00:00.123456789+05:30', (dt + time.seconds(2)).format())
t.eq('2026-11-14T23:59:58.123456789+05:30', (dt - time.days(1)).format())
t.eq('2026-12-31T23:59:58.123456789+05:30', dt.add_days(46)!.format())
t.eq('2027-02-15T23:59:58.123456789+05:30', dt.add_months(3)!.format())
t.eq('2025-11-15T23:59:58.123456789+05:30', dt.add_years(-1)!.format())
t.eq('2024-02-29T12:00:00+09:00', time.datetime(2024, 1, 31, 12, 0, 0, 0, 540)!.add_months(1)!.format())
t.eq(error.Range, dt.add(time.days(3000000)).unwrap_error())
t.eq(error.Range, dt.add_years(8000).unwrap_error())

-- Instants.
t.eq('1970-01-01T00:00:00Z', time.unix(0)!.format())
t.eq('1969-12-31T23:59:59.999Z', time.unix_millis(-1)!.format())
t.eq(-1, time.unix_millis(-1)!.unix())
t.eq(-1, time.unix_millis(-1)!.unix_millis())
t.eq('1970-01-01T00:00:01.5Z', time.unix(0, 1500000000)!.format())
t.eq('1969-12-31T23:59:59.5Z', time.unix(0, -500000000)!.format())
t.eq('9999-12-30T23:59:59.999999999Z', time.unix(253402214399, 999999999)!.format())
t.eq('0001-01-02T00:00:00Z', time.unix(-62135510400)!.format())
t.eq(error.Range, time.unix(253402214400).unwrap_error())
t.eq(error.Range, time.unix(-62135510401).unwrap_error())
t.eq(error.Range, time.unix(9223372036854775807, 2000000000).unwrap_error())
a := time.unix(10)!
b := time.unix(12, 500000000)!
t.eq(true, a < b)
t.eq(true, a <= b)
t.eq(false, a > b)
t.eq(false, a >= b)
t.eq(true, a == time.unix(9, 1000000000)!)
t.eq('2.5s', (b - a).format())
t.eq('-2.5s', (a - b).format())
t.eq(true, a + (b - a) == b)
t.eq(true, b - (b - a) == a)
t.eq(error.Range, time.unix(253402214399)!.add(time.seconds(1)).unwrap_error())
t.eq('1970/01/01 00:00', time.unix(10)!.format('%Y/%m/%d %H:%M')!)
t.eq('1970-01-01T05:30:10+05:30', a.to_offset(330)!.format())

-- The clocks.
n1 := time.now()
t.eq(true, n1 > time.datetime(2026, 1, 1, 0, 0, 0)!.time())
m1 := time.monotonic()
m2 := time.monotonic()
t.eq(true, m2 >= m1)
t.eq(false, (m2 - m1).is_negative())

-- Durations.
t.eq('1h2m3.5s', (time.hours(1) + time.minutes(2) + time.millis(3500)).format())
t.eq('0s', time.seconds(0).format())
t.eq('-1h30m', time.minutes(-90).format())
t.eq('48h', time.days(2).format())
t.eq('0.000000001s', time.nanos(1).format())
t.eq('0.000001s', time.micros(1).format())
t.eq('-1.5s', time.millis(-1500).format())
t.eq(-1, time.millis(-1500).secs())
t.eq(-500000000, time.millis(-1500).subsec_nanos())
t.eq(-1500, time.millis(-1500).millis())
t.eq(1, time.millis(1999).secs())
t.eq(1.5, time.millis(-1500).abs().to_float())
t.eq(-0.25, time.millis(-250).to_float())
t.eq('-4.5s', (time.nanos(1500000000) * -3).format())
t.eq('23h59m59.999999999s', (time.days(1) - time.nanos(1)).format())
t.eq('-5s', (-time.seconds(5)).format())
t.eq(true, time.seconds(1) < time.millis(1001))
t.eq(true, time.millis(-1) < time.seconds(0))
t.eq(true, time.minutes(1) == time.seconds(60))
t.eq(true, time.millis(-1500) == -time.millis(1500))
t.eq(true, time.seconds(2) >= time.seconds(2))
t.eq(true, time.seconds(3) > time.seconds(2))
t.eq(true, time.seconds(2) <= time.seconds(2))
t.eq(true, time.millis(-1).is_negative())
t.eq('87649h', (time.nanos(999999999) * 315537897).format()[0..6])

-- RFC 3339.
p := time.parse('2026-11-15T10:22:03.25+09:00')!
t.eq(540, p.offset())
t.eq(250000000, p.nanosecond())
t.eq('2026-11-15T01:22:03.25Z', p.utc().format())
t.eq(-1, time.parse('1969-12-31t23:59:59.5z')!.time().unix())
t.eq('2026-11-15T10:22:01-03:30', time.parse('2026-11-15 10:22:01-0330')!.format())
t.eq('2026-11-15T10:22:01+09:00', time.parse('2026-11-15T10:22:01+09')!.format())
t.eq('2026-11-15T10:22:01Z', time.parse('2026-11-15T10:22:01-00:00')!.format())
-- Digits of the fraction past the ninth are dropped.
t.eq('2026-11-15T10:22:01.123456789Z', time.parse('2026-11-15T10:22:01.1234567899Z')!.format())
-- A leap second reads as the second before.
t.eq('2016-12-31T23:59:59Z', time.parse('2016-12-31T23:59:60Z')!.format())
-- A text without an offset is read at the offset that is passed. An offset in the text wins.
t.eq('2026-11-15T10:22:01.123+09:00', time.parse('2026-11-15 10:22:01,123', 540)!.format())
t.eq('2026-11-15T10:22:01Z', time.parse('2026-11-15T10:22:01', 0)!.format())
t.eq('2026-11-15T10:22:01-03:30', time.parse('2026-11-15 10:22:01-03:30', 540)!.format())
t.eq(error.Range, time.parse('2026-11-15 10:22:01', 1440).unwrap_error())

var diag time.Diag = {}
t.eq(error.Syntax, time.parse('2026-11-15 10:22:01', &diag).unwrap_error())
t.eq(19, diag.pos)
t.eq('The text has no UTC offset such as `Z` or `+09:00`. To read it at an offset, pass the offset in minutes: `time.parse(s, 0)` reads it as UTC.', diag.msg)
t.eq(error.Range, time.parse('2026-13-15T10:22:01Z', &diag).unwrap_error())
t.eq('A month is 1 to 12, found 13.', diag.msg)
t.eq(error.Range, time.parse('2026-02-30T10:22:01Z', &diag).unwrap_error())
t.eq('February 2026 has no day 30.', diag.msg)
t.eq(error.Range, time.parse('2026-11-15T24:00:00Z', &diag).unwrap_error())
t.eq('An hour is 0 to 23, found 24.', diag.msg)
t.eq(error.Range, time.parse('2026-11-15T10:22:61Z', &diag).unwrap_error())
t.eq('A second is 0 to 59, found 61.', diag.msg)
t.eq(error.Range, time.parse('2026-11-15T10:22:01+24:00', &diag).unwrap_error())
t.eq(19, diag.pos)
t.eq('A UTC offset is at most 23:59.', diag.msg)
t.eq(error.Range, time.parse('0000-11-15T10:22:01Z', &diag).unwrap_error())
t.eq('A year is 1 to 9999, found 0.', diag.msg)
t.eq(error.Range, time.parse('0001-01-01T00:00:00Z', &diag).unwrap_error())
t.eq('The time is out of range: years 1 to 9999.', diag.msg)
t.eq(error.Syntax, time.parse('2026-11-15T10:22Z', &diag).unwrap_error())
t.eq(16, diag.pos)
t.eq('Expected `:` after the minute, found `Z`.', diag.msg)
t.eq(error.Syntax, time.parse('2026-11-15T10:22:01Zx', &diag).unwrap_error())
t.eq('Expected the end of the text after the UTC offset, found `x`.', diag.msg)
t.eq(error.Syntax, time.parse('한글', &diag).unwrap_error())
t.eq('Expected a four digit year, found `한`.', diag.msg)
t.eq(error.Syntax, time.parse('2026-11-15', &diag).unwrap_error())
t.eq('Expected `T` or a space between the date and the time of day, found the end of the text.', diag.msg)
t.eq(error.Syntax, time.parse('2026-11-15T10:22:01.Z', &diag).unwrap_error())
t.eq(error.Syntax, time.parse('2026-11-15T10:22:01+9:00', &diag).unwrap_error())
t.eq(error.Syntax, time.parse('', &diag).unwrap_error())
t.eq(error.Syntax, time.parse('20261115T102201Z').unwrap_error())

-- Dates and offsets as text.
t.eq('2026-11-15', time.parse_date('2026-11-15')!.format())
t.eq(error.Range, time.parse_date('2026-11-31', &diag).unwrap_error())
t.eq('November 2026 has no day 31.', diag.msg)
t.eq(error.Syntax, time.parse_date('2026-11-15T00:00:00Z', &diag).unwrap_error())
t.eq(10, diag.pos)
t.eq(error.Syntax, time.parse_date('2026/11/15').unwrap_error())
t.eq(330, time.parse_offset('+05:30')!)
t.eq(-210, time.parse_offset('-0330')!)
t.eq(0, time.parse_offset('Z')!)
t.eq(540, time.parse_offset('+09')!)
t.eq(-1439, time.parse_offset('-23:59')!)
t.eq(error.Range, time.parse_offset('+24:00').unwrap_error())
t.eq(error.Range, time.parse_offset('+05:60').unwrap_error())
t.eq(error.Syntax, time.parse_offset('0530').unwrap_error())
t.eq(error.Syntax, time.parse_offset('+05:30x').unwrap_error())
t.eq('-03:30', time.format_offset(-210))
t.eq('+00:00', time.format_offset(0))
t.eq('+23:59', time.format_offset(1439))

-- Formats.
t.eq('Wed Wednesday Jan January 31 031 3 3 2024-W05 24 01/31/24 %', d.format('%a %A %b %B %e %j %u %w %G-W%V %y %D %%')!)
t.eq(' 5|05|Tue', time.date(2026, 5, 5)!.format('%e|%d|%a')!)
t.eq('2026-11-15 23:59:58.123456 +0530 +05:30 123 123456789 11 PM 1794767398 23:59', dt.format('%F %T.%f %z %:z %3f %9f %I %p %s %R')!)
t.eq('12 AM|12 PM|01 PM', time.date(2026, 1, 1)!.at(0, 0, 0)!.format('%I %p|')! + time.date(2026, 1, 1)!.at(12, 0, 0)!.format('%I %p|')! + time.date(2026, 1, 1)!.at(13, 0, 0)!.format('%I %p')!)
t.eq('-0330|+0000|-00:01', dt.to_offset(-210)!.format('%z|')! + dt.utc().format('%z|')! + dt.to_offset(-1)!.format('%:z')!)
t.eq('a\tb\n', dt.format('a%tb%n')!)
t.eq('', dt.format('')!)
t.eq(error.Format, dt.format('%Q').unwrap_error())
t.eq(error.Format, dt.format('%').unwrap_error())
t.eq(error.Format, dt.format('%:m').unwrap_error())
t.eq(error.Format, dt.format('%3d').unwrap_error())
-- A date has no time of day and no offset.
t.eq(error.Format, d.format('%H').unwrap_error())
t.eq(error.Format, d.format('%z').unwrap_error())
t.eq(error.Format, d.format('%s').unwrap_error())
t.eq(error.Format, d.format('%T').unwrap_error())

-- Parsing by a format.
t.eq('2026-11-15T10:22:01+09:00', time.parse_format('15/Nov/2026:10:22:01 +0900', '%d/%b/%Y:%H:%M:%S %z')!.format())
t.eq('1970-11-05T10:22:01Z', time.parse_format('Nov  5 10:22:01', '%b %e %T')!.format())
t.eq('2026-11-15T13:05:00-05:00', time.parse_format('sunday, november 15 2026 1:05 pm', '%A, %B %d %Y %I:%M %p', -300)!.format())
t.eq('2026-11-15T00:05:00Z', time.parse_format('12:05 AM 2026-11-15', '%I:%M %p %F')!.format())
t.eq('2025-11-15T10:22:01.25Z', time.parse_format('1763202121.250', '%s.%f')!.format())
t.eq('1970-01-01T08:59:50+09:00', time.parse_format('-10', '%s', 540)!.format())
t.eq('2026-11-16T00:00:00Z', time.parse_format('2026-320', '%Y-%j')!.format())
t.eq('2024-12-31T00:00:00Z', time.parse_format('366 2024', '%j %Y')!.format())
t.eq('2026-11-15T10:22:01.123Z', time.parse_format('2026-11-15 10:22:01,123', '%F %T,%3f')!.format())
t.eq('1999-01-02T00:00:00Z', time.parse_format('01/02/99', '%D')!.format())
t.eq('2068-01-02T00:00:00Z', time.parse_format('68-1-2', '%y-%m-%d')!.format())
t.eq('2026-11-15T10:22:00+05:45', time.parse_format('2026-11-15 10:22 +05:45', '%F %R %:z')!.format())
t.eq('2026-11-15T10:22:00Z', time.parse_format('2026-11-15 10:22 Z', '%F %R %z')!.format())
t.eq('2026-11-15T00:00:00Z', time.parse_format('100% 2026-11-15', '100%% %F')!.format())
-- The offset of the text wins over the one that is passed.
t.eq('2026-11-15T10:22:00+09:00', time.parse_format('2026-11-15 10:22 +0900', '%F %R %z', -300)!.format())
t.eq(error.Format, time.parse_format('2026', '%Q', &diag).unwrap_error())
t.eq(0, diag.pos)
t.eq('Unknown specifier `%Q`. See `DateTime.format` for the list.', diag.msg)
t.eq(error.Format, time.parse_format('2026 1', '%Y %G', &diag).unwrap_error())
t.eq(3, diag.pos)
t.eq('`%G` is for output only. Parse the date with `%Y`, `%m` and `%d`, or with `%j`.', diag.msg)
t.eq(error.Format, time.parse_format('2026', '%Y%', &diag).unwrap_error())
t.eq('The format ends with a single `%`. Write `%%` for a percent sign.', diag.msg)
t.eq(error.Format, time.parse_format('2026', '%:Y', &diag).unwrap_error())
t.eq(error.Syntax, time.parse_format('2026x', '%Y', &diag).unwrap_error())
t.eq(4, diag.pos)
t.eq('Expected the end of the text after the format, found `x`.', diag.msg)
t.eq(error.Syntax, time.parse_format('2026-11', '%Y/%m', &diag).unwrap_error())
t.eq('Expected `/`, found `-`.', diag.msg)
t.eq(error.Syntax, time.parse_format('Nev 5', '%b %d', &diag).unwrap_error())
t.eq('Expected the name of a month such as `Nov` or `November`, found `N`.', diag.msg)
t.eq(error.Syntax, time.parse_format('20261115', '%Y %m', &diag).unwrap_error())
t.eq('Expected a space, found `1`.', diag.msg)
t.eq(error.Range, time.parse_format('13 PM', '%I %p', &diag).unwrap_error())
t.eq('An hour with AM or PM is 1 to 12, found 13.', diag.msg)
t.eq(error.Range, time.parse_format('366 2023', '%j %Y', &diag).unwrap_error())
t.eq('2023 has no day 366.', diag.msg)
t.eq(error.Range, time.parse_format('367', '%j', &diag).unwrap_error())
t.eq(error.Range, time.parse_format('2026-11-15', '%F', 1440).unwrap_error())
t.eq(error.Range, time.parse_format('999999999999', '%s').unwrap_error())

-- A format gives back what it wrote.
for {'%Y-%m-%d %H:%M:%S.%9f %z', '%d/%b/%Y:%H:%M:%S %:z.%9f', '%A, %B %e %Y %I:%M:%S.%9f %p %z', '%s.%9f %z', '%Y %j %T,%9f%z'} |fmt|:
    back := time.parse_format(dt.format(fmt)!, fmt)!
    t.eq(true, back == dt)

-- Time zones from a POSIX rule. They need no time zone database.
ny := time.zone_from_posix('EST5EDT,M3.2.0,M11.1.0')!
t.eq('EST5EDT,M3.2.0,M11.1.0', ny.name())
jul := time.parse('2026-07-04T12:00:00Z')!.time()
jan := time.parse('2026-01-04T12:00:00Z')!.time()
t.eq(-240, ny.offset_at(jul))
t.eq(true, ny.is_dst(jul))
t.eq('EDT', ny.abbreviation(jul))
t.eq(-300, ny.offset_at(jan))
t.eq(false, ny.is_dst(jan))
t.eq('EST', ny.abbreviation(jan))
t.eq('2026-07-04T08:00:00-04:00', jul.to_zone(ny).format())
t.eq('2026-01-04 07:00:00 EST -0500', jan.to_zone(ny).format('%F %T %Z %z')!)
t.eq('2026-07-04T08:00:00-04:00', time.parse('2026-07-04T21:00:00+09:00')!.to_zone(ny).format())
-- The second of each transition.
t.eq('2026-03-08T01:59:59-05:00', time.parse('2026-03-08T06:59:59Z')!.to_zone(ny).format())
t.eq('2026-03-08T03:00:00-04:00', time.parse('2026-03-08T07:00:00Z')!.to_zone(ny).format())
t.eq('2026-11-01T01:59:59-04:00', time.parse('2026-11-01T05:59:59Z')!.to_zone(ny).format())
t.eq('2026-11-01T01:00:00-05:00', time.parse('2026-11-01T06:00:00Z')!.to_zone(ny).format())

-- A time of day that is skipped, and one that comes twice.
t.eq('2026-03-08T03:30:00-04:00', ny.datetime(2026, 3, 8, 2, 30, 0)!.format())
t.eq('2026-03-08T03:30:00-04:00', ny.datetime(2026, 3, 8, 2, 30, 0, 0, .later)!.format())
t.eq('2026-03-08T01:30:00-05:00', ny.datetime(2026, 3, 8, 2, 30, 0, 0, .earlier)!.format())
t.eq(error.Skipped, ny.datetime(2026, 3, 8, 2, 30, 0, 0, .reject).unwrap_error())
t.eq('2026-11-01T01:30:00-04:00', ny.datetime(2026, 11, 1, 1, 30, 0)!.format())
t.eq('2026-11-01T01:30:00-04:00', ny.datetime(2026, 11, 1, 1, 30, 0, 0, .earlier)!.format())
t.eq('2026-11-01T01:30:00.5-05:00', ny.datetime(2026, 11, 1, 1, 30, 0, 500000000, .later)!.format())
t.eq(error.Ambiguous, ny.datetime(2026, 11, 1, 1, 30, 0, 0, .reject).unwrap_error())
t.eq('2026-07-04T08:00:00-04:00', ny.datetime(2026, 7, 4, 8, 0, 0, 0, .reject)!.format())
t.eq('2026-03-08T03:00:00-04:00', ny.datetime(2026, 3, 8, 3, 0, 0, 0, .reject)!.format())
t.eq('2026-03-08T01:59:59-05:00', ny.datetime(2026, 3, 8, 1, 59, 59, 0, .reject)!.format())
t.eq(error.Range, ny.datetime(2026, 2, 30, 0, 0, 0).unwrap_error())
t.eq(error.Range, ny.datetime(2026, 3, 8, 24, 0, 0).unwrap_error())
t.eq('2026-03-08T03:30:00-04:00', time.date(2026, 3, 8)!.at(2, 30, 0, ny)!.format())
t.eq('2026-03-08T03:30:00-04:00', time.datetime(2026, 3, 8, 2, 30, 0)!.replace_zone(ny)!.format())
t.eq('2026-11-15T10:22:01.123-05:00', time.parse('2026-11-15 10:22:01,123', 0)!.replace_zone(ny)!.format())

-- In a zone, a day is not always 24 hours.
noon := ny.datetime(2026, 3, 7, 12, 0, 0)!
t.eq('2026-03-08T12:00:00-04:00', noon.add_days(1)!.format())
t.eq('2026-03-08T13:00:00-04:00', (noon + time.hours(24)).format())
t.eq('2026-03-08T13:00:00-04:00', noon.add(time.days(1))!.format())
t.eq('2026-03-06T12:00:00-05:00', (noon - time.hours(24)).format())
t.eq('2026-11-07T12:00:00-05:00', noon.add_months(8)!.format())
t.eq('2027-03-07T12:00:00-05:00', noon.add_years(1)!.format())
t.eq('2026-03-08T03:30:00-04:00', ny.datetime(2026, 3, 7, 2, 30, 0)!.add_days(1)!.format())
t.eq('2026-03-09T02:30:00-04:00', ny.datetime(2026, 3, 7, 2, 30, 0)!.add_days(2)!.format())
t.eq(23, (noon.add_days(1)!.time() - noon.time()).secs() / 3600)

-- A value keeps its zone until it is given an offset.
t.eq('EST5EDT,M3.2.0,M11.1.0', noon.zone().?.name())
t.eq('EST5EDT,M3.2.0,M11.1.0', noon.add_days(1)!.zone().?.name())
t.eq(true, noon.utc().zone() == none)
t.eq(true, noon.to_offset(-300)!.zone() == none)
t.eq(true, noon.replace_offset(-300)!.zone() == none)
t.eq(true, time.unix(0)!.utc().zone() == none)
t.eq(true, noon == ny.datetime(2026, 3, 7, 12, 0, 0)!)
t.eq(true, noon == noon.time().to_zone(time.zone_from_posix('EST5EDT,M3.2.0,M11.1.0')!))
t.eq(false, noon == noon.to_offset(-300)!)
t.eq(false, noon == noon.to_zone(time.zone_from_posix('EST5')!))
t.eq(true, noon.time() == noon.to_offset(-300)!.time())

-- Other shapes of a rule.
syd := time.zone_from_posix('AEST-10AEDT,M10.1.0,M4.1.0/3')!
t.eq('2026-01-04 23:00:00 AEDT', jan.to_zone(syd).format('%F %T %Z')!)
t.eq('2026-07-04 22:00:00 AEST', jul.to_zone(syd).format('%F %T %Z')!)
t.eq('2026-04-05T02:59:59+11:00', time.parse('2026-04-04T15:59:59Z')!.to_zone(syd).format())
t.eq('2026-04-05T02:00:00+10:00', time.parse('2026-04-04T16:00:00Z')!.to_zone(syd).format())
t.eq('2026-10-04T03:00:00+11:00', time.parse('2026-10-03T16:00:00Z')!.to_zone(syd).format())
lhi := time.zone_from_posix('<+1030>-10:30<+11>-11,M10.1.0,M4.1.0')!
t.eq('2026-07-04 22:30:00 +1030 +1030', jul.to_zone(lhi).format('%F %T %Z %z')!)
t.eq('2026-01-04 23:00:00 +11', jan.to_zone(lhi).format('%F %T %Z')!)
kst := time.zone_from_posix('KST-9')!
t.eq(540, kst.offset_at(jul))
t.eq(false, kst.is_dst(jul))
t.eq('2026-07-04 21:00:00 KST', jul.to_zone(kst).format('%F %T %Z')!)
t.eq(345, time.zone_from_posix('<+0545>-5:45')!.offset_at(jul))
t.eq(-210, time.zone_from_posix('NST3:30')!.offset_at(jul))
-- Without days, the rule of the United States.
t.eq(true, time.zone_from_posix('EST5EDT')!.is_dst(jul))
t.eq(false, time.zone_from_posix('EST5EDT')!.is_dst(jan))
-- `Jn` does not count February 29, `n` does. Both rules start on March 1 of 2024, a leap year.
jz := time.zone_from_posix('AAA0BBB,J60/0,J305/0')!
nz := time.zone_from_posix('AAA0BBB,60/0,304/0')!
t.eq(false, jz.is_dst(time.parse('2024-02-29T23:59:59Z')!.time()))
t.eq(true, jz.is_dst(time.parse('2024-03-01T00:00:00Z')!.time()))
t.eq(false, nz.is_dst(time.parse('2024-02-29T23:59:59Z')!.time()))
t.eq(true, nz.is_dst(time.parse('2024-03-01T00:00:00Z')!.time()))
t.eq(true, jz.is_dst(time.parse('2023-03-01T00:00:00Z')!.time()))
t.eq(false, jz.is_dst(time.parse('2023-02-28T23:59:59Z')!.time()))
-- The last week of a month, and a negative time of day.
cet := time.zone_from_posix('CET-1CEST,M3.5.0,M10.5.0/3')!
t.eq('2026-03-29T03:00:00+02:00', time.parse('2026-03-29T01:00:00Z')!.to_zone(cet).format())
t.eq('2026-03-29T01:59:59+01:00', time.parse('2026-03-29T00:59:59Z')!.to_zone(cet).format())
t.eq('2026-10-25T02:00:00+01:00', time.parse('2026-10-25T01:00:00Z')!.to_zone(cet).format())
god := time.zone_from_posix('<-02>2<-01>,M3.5.0/-1,M10.5.0/0')!
t.eq('2026-03-29T00:00:00-01:00', time.parse('2026-03-29T01:00:00Z')!.to_zone(god).format())
t.eq('2026-03-28T22:59:59-02:00', time.parse('2026-03-29T00:59:59Z')!.to_zone(god).format())
t.eq(error.Syntax, time.zone_from_posix('').unwrap_error())
t.eq(error.Syntax, time.zone_from_posix('X').unwrap_error())
t.eq(error.Syntax, time.zone_from_posix('EST').unwrap_error())
t.eq(error.Syntax, time.zone_from_posix('EST25').unwrap_error())
t.eq(error.Syntax, time.zone_from_posix('EST5EDT,M13.1.0,M11.1.0').unwrap_error())
t.eq(error.Syntax, time.zone_from_posix('EST5EDT,M3.2.0').unwrap_error())
t.eq(error.Syntax, time.zone_from_posix('EST5EDT,M3.2.0,M11.1.0x').unwrap_error())
t.eq(error.Syntax, time.zone_from_posix('EST5EDT,J366,J1').unwrap_error())
t.eq(error.Syntax, time.zone_from_posix('<EST5').unwrap_error())

-- `UTC` needs no database. A name that the system does not have, or that is not a zone name, is not found.
utc := time.zone('UTC')!
t.eq('UTC', utc.name())
t.eq(0, utc.offset_at(jul))
t.eq('2026-07-04 12:00:00 UTC +0000', jul.to_zone(utc).format('%F %T %Z %z')!)
t.eq(error.NotFound, time.zone('Nope/Zone').unwrap_error())
t.eq(error.NotFound, time.zone('').unwrap_error())
t.eq(error.NotFound, time.zone('../../etc/passwd').unwrap_error())
t.eq(error.NotFound, time.zone('/etc/localtime').unwrap_error())
t.eq(error.Syntax, time.zone_from_tzif('x', []byte{1, 2, 3}).unwrap_error())
var junk []byte = {}
junk = junk.append('TZif2 and then nothing that a file of zone data would have in it'.span())
t.eq(error.Syntax, time.zone_from_tzif('x', junk).unwrap_error())

-- `%Z` of a value without a zone is `UTC` or the offset. It is not parsed.
t.eq('UTC', dt.utc().format('%Z')!)
t.eq('+05:30', dt.format('%Z')!)
t.eq(error.Format, d.format('%Z').unwrap_error())
t.eq(error.Format, time.parse_format('UTC', '%Z', &diag).unwrap_error())
t.eq('`%Z` is for output only: an abbreviation such as `CST` names more than one zone. Parse the offset with `%z`, or read the text in a zone with `replace_zone`.', diag.msg)

-- RFC 9557: the zone in brackets. `UTC` and an offset in brackets need no database.
t.eq('2026-07-04T12:00:00+00:00[UTC]', jul.to_zone(utc).format_zoned())
t.eq(true, time.parse_zoned('2026-07-04T12:00:00+00:00[UTC]')! == jul.to_zone(utc))
t.eq(true, time.parse_zoned('2026-07-04T12:00:00Z[UTC]')! == jul.to_zone(utc))
t.eq(true, time.parse_zoned('2026-07-04T12:00:00[!UTC]')! == jul.to_zone(utc))
t.eq('UTC', time.parse_zoned('2026-07-04T12:00:00.5Z[UTC][u-ca=gregory]')!.zone().?.name())
-- A value without a zone, or in a zone of a rule, is written without brackets.
t.eq('2026-11-15T23:59:58.123456789+05:30', dt.format_zoned())
t.eq('2026-07-04T12:00:00Z', jul.utc().format_zoned())
t.eq('2026-07-04T08:00:00-04:00', jul.to_zone(ny).format_zoned())
-- A text without brackets is read as `parse` reads it. An offset in brackets is a fixed offset.
t.eq(true, time.parse_zoned('2026-11-15T23:59:58.123456789+05:30')! == dt)
t.eq('2026-07-04T21:00:00+09:00', time.parse_zoned('2026-07-04T21:00:00+09:00[+09:00]')!.format())
t.eq('2026-07-04T21:00:00+09:00', time.parse_zoned('2026-07-04T21:00:00[+09:00]')!.format())
t.eq('2026-07-04T21:00:00+09:00', time.parse_zoned('2026-07-04T12:00:00Z[+09:00]')!.format())
t.eq(true, time.parse_zoned('2026-07-04T21:00:00[+09:00]')!.zone() == none)
t.eq(error.Conflict, time.parse_zoned('2026-07-04T12:00:00+09:00[+08:00]', &diag).unwrap_error())
t.eq(26, diag.pos)
t.eq('The offset of the text is +09:00 and the offset in the brackets is +08:00.', diag.msg)
t.eq(error.Conflict, time.parse_zoned('2026-07-04T12:00:00+09:00[UTC]', &diag).unwrap_error())
t.eq('The offset of the text is +09:00, and `UTC` is at +00:00 at that time.', diag.msg)
t.eq(error.NotFound, time.parse_zoned('2026-07-04T12:00:00+09:00[Nope/Zone]', &diag).unwrap_error())
t.eq('The system has no time zone `Nope/Zone`.', diag.msg)
t.eq(error.Syntax, time.parse_zoned('2026-07-04T12:00:00', &diag).unwrap_error())
t.eq('The text has no UTC offset and no time zone in brackets.', diag.msg)
t.eq(error.Syntax, time.parse_zoned('2026-07-04T12:00:00Z[!u-ca=x]', &diag).unwrap_error())
t.eq('The tag `u-ca=x` is marked as required with `!`, and it is not known here.', diag.msg)
t.eq(error.Syntax, time.parse_zoned('2026-07-04T12:00:00Z[UTC', &diag).unwrap_error())
t.eq('This `[` is not closed.', diag.msg)
t.eq(error.Syntax, time.parse_zoned('2026-07-04T12:00:00Z[UTC][UTC]', &diag).unwrap_error())
t.eq(error.Syntax, time.parse_zoned('2026-07-04T12:00:00Z[]', &diag).unwrap_error())
t.eq(error.Syntax, time.parse_zoned('2026-07-04T12:00:00Z[UTC]x', &diag).unwrap_error())
t.eq(error.Syntax, time.parse_zoned('2026-07-04T12:00:00Z[+9]', &diag).unwrap_error())
t.eq(error.Range, time.parse_zoned('2026-07-04T12:00:00Z[+24:00]', &diag).unwrap_error())
t.eq(error.Range, time.parse_zoned('2026-02-30T12:00:00Z[UTC]', &diag).unwrap_error())
-- `parse` does not read the brackets.
t.eq(error.Syntax, time.parse('2026-07-04T12:00:00Z[UTC]', &diag).unwrap_error())
t.eq('A time zone in brackets is read by `time.parse_zoned`.', diag.msg)
t.eq(error.Syntax, time.parse('2026-07-04T12:00:00[UTC]', 0, &diag).unwrap_error())

--cytest: pass