use test

-- Template variants that share a leading const parameter must stay distinct (F-23).
-- Before the fix, `VariantKeyContext.eql` returned after the first non-Type parameter,
-- so a fingerprint collision made `Buf[1, 47]` resolve to the `Buf[1, 45]` instance.
type Buf[const A int, const N int]:
    data [N]byte

test.eq(1, type.size(Buf[1, 1]))
test.eq(2, type.size(Buf[1, 2]))
test.eq(3, type.size(Buf[1, 3]))
test.eq(4, type.size(Buf[1, 4]))
test.eq(5, type.size(Buf[1, 5]))
test.eq(6, type.size(Buf[1, 6]))
test.eq(7, type.size(Buf[1, 7]))
test.eq(8, type.size(Buf[1, 8]))
test.eq(9, type.size(Buf[1, 9]))
test.eq(10, type.size(Buf[1, 10]))
test.eq(11, type.size(Buf[1, 11]))
test.eq(12, type.size(Buf[1, 12]))
test.eq(13, type.size(Buf[1, 13]))
test.eq(14, type.size(Buf[1, 14]))
test.eq(15, type.size(Buf[1, 15]))
test.eq(16, type.size(Buf[1, 16]))
test.eq(17, type.size(Buf[1, 17]))
test.eq(18, type.size(Buf[1, 18]))
test.eq(19, type.size(Buf[1, 19]))
test.eq(20, type.size(Buf[1, 20]))
test.eq(21, type.size(Buf[1, 21]))
test.eq(22, type.size(Buf[1, 22]))
test.eq(23, type.size(Buf[1, 23]))
test.eq(24, type.size(Buf[1, 24]))
test.eq(25, type.size(Buf[1, 25]))
test.eq(26, type.size(Buf[1, 26]))
test.eq(27, type.size(Buf[1, 27]))
test.eq(28, type.size(Buf[1, 28]))
test.eq(29, type.size(Buf[1, 29]))
test.eq(30, type.size(Buf[1, 30]))
test.eq(31, type.size(Buf[1, 31]))
test.eq(32, type.size(Buf[1, 32]))
test.eq(33, type.size(Buf[1, 33]))
test.eq(34, type.size(Buf[1, 34]))
test.eq(35, type.size(Buf[1, 35]))
test.eq(36, type.size(Buf[1, 36]))
test.eq(37, type.size(Buf[1, 37]))
test.eq(38, type.size(Buf[1, 38]))
test.eq(39, type.size(Buf[1, 39]))
test.eq(40, type.size(Buf[1, 40]))
test.eq(41, type.size(Buf[1, 41]))
test.eq(42, type.size(Buf[1, 42]))
test.eq(43, type.size(Buf[1, 43]))
test.eq(44, type.size(Buf[1, 44]))
test.eq(45, type.size(Buf[1, 45]))
test.eq(46, type.size(Buf[1, 46]))
test.eq(47, type.size(Buf[1, 47]))
test.eq(48, type.size(Buf[1, 48]))
test.eq(49, type.size(Buf[1, 49]))
test.eq(50, type.size(Buf[1, 50]))
test.eq(51, type.size(Buf[1, 51]))
test.eq(52, type.size(Buf[1, 52]))
test.eq(53, type.size(Buf[1, 53]))
test.eq(54, type.size(Buf[1, 54]))
test.eq(55, type.size(Buf[1, 55]))
test.eq(56, type.size(Buf[1, 56]))
test.eq(57, type.size(Buf[1, 57]))
test.eq(58, type.size(Buf[1, 58]))
test.eq(59, type.size(Buf[1, 59]))

-- Distinct variants are distinct types; equal params give the same type.
test.eq(true, #{Buf[1, 45] == Buf[1, 45]})
test.eq(false, #{Buf[1, 45] == Buf[1, 47]})
test.eq(false, #{Buf[1, 2] == Buf[2, 1]})

--cytest: pass
